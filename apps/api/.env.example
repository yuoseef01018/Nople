# ============================================================================
# Nople — Environment Variables for Production Deployment
# ============================================================================
# Copy this file to .env (or set these in your Railway project variables)
# and fill in the values from your Railway PostgreSQL & Redis services.
# ============================================================================

# ---- Database ----
# Get this from Railway → PostgreSQL service → "Connect" tab → "Postgres URL"
DATABASE_URL=postgresql://user:password@host:port/database

# ---- Redis ----
# Get this from Railway → Redis service → "Connect" tab → "Redis URL"
REDIS_URL=redis://default:password@host:port

# ---- CORS Origins ----
# Replace with your Railway app domain (the public URL Railway gives you)
# Format: https://your-app.up.railway.app (NO trailing slash)
STORE_CORS=https://your-app.up.railway.app,http://localhost:8000
ADMIN_CORS=https://your-app.up.railway.app/dashboard,http://localhost:7000
VENDOR_CORS=https://your-app.up.railway.app/seller,http://localhost:7001
AUTH_CORS=https://your-app.up.railway.app,http://localhost:8000

# ---- Security Secrets ----
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-secure-random-string
COOKIE_SECRET=replace-with-a-secure-random-string

# ---- File Storage (local provider) ----
# The public URL where uploaded files are accessible
# Replace with your Railway domain + /static
FILE_BACKEND_URL=https://your-app.up.railway.app/static

# ---- Vendor Panel URL (for admin panel cross-linking) ----
MERCUR_VENDOR_URL=https://your-app.up.railway.app/seller

# ---- Admin Panel Vite Build Variables ----
VITE_MERCUR_BACKEND_URL=https://your-app.up.railway.app
VITE_MERCUR_VENDOR_URL=https://your-app.up.railway.app/seller

# ---- Vendor Panel Vite Build Variables ----
# (VITE_MERCUR_BACKEND_URL is shared above)

# ---- Node Environment ----
NODE_ENV=production
